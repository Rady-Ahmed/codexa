# Optional: Slack/Discord incoming webhook URL to receive contact-form leads
NOTIFY_WEBHOOK_URL=

# Optional: transactional email via Resend (alternative/addition to the webhook)
RESEND_API_KEY=
NOTIFY_EMAIL_TO=

# Optional: error tracking (client-side). Leave empty to disable Sentry entirely.
VITE_SENTRY_DSN=

# Optional: privacy-friendly analytics (Plausible). Leave empty to load no
# analytics script at all — nothing is sent anywhere by default.
VITE_PLAUSIBLE_DOMAIN=
